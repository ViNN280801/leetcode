# clangd configuration for a flat repo of standalone LeetCode solutions.
#
# There is no build system and no compile_commands.json here, so clangd uses
# its fallback command (`clang <file>`). Everything a file needs to compile —
# language standard, warnings — is provided below, per file extension.
# The language itself (C or C++) is inferred by clangd from the extension.
#
# Check a file:  clangd --check="1. Two Sum.cpp"

# ============================================================================
# C++ sources
# ============================================================================
If:
  PathMatch: .*\.(cpp|cc|cxx)
CompileFlags:
  Add:
    # LeetCode compiles C++ with clang using the C++23 standard.
    - -std=c++23
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wconversion
    - -Wsign-conversion
    # GoogleTest headers for the tests at the bottom of solution files. There is
    # no system-wide gtest, so the vendored copy from PEAK_EXPERT_CE is used.
    # -isystem keeps gtest's own headers out of warnings and clang-tidy.
    - -isystem/home/vladislavsemykin/Develop/PEAK_EXPERT_CE/BusinessLogic/LumexLib/3rdparty/googletest-1.18.0/googletest/include

---
# ============================================================================
# C sources
# ============================================================================
If:
  PathMatch: .*\.c
CompileFlags:
  Add:
    - -std=c17
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wconversion

---
# ============================================================================
# Settings shared by all files
# ============================================================================
Index:
  Background: Build
  StandardLibrary: true

Diagnostics:
  # Report includes that are not used, and symbols used without their header.
  UnusedIncludes: Strict
  MissingIncludes: Strict

  # Checks themselves are configured in .clang-tidy; run only fast ones live.
  ClangTidy:
    FastCheckFilter: Strict

  # Noise for single-file solutions (short names, magic sizes, `Solution`
  # methods dictated by LeetCode signatures, etc.).
  Suppress:
    - modernize-use-trailing-return-type
    - readability-identifier-length
    - readability-identifier-naming
    - readability-braces-around-statements
    - readability-function-cognitive-complexity
    - readability-convert-member-functions-to-static
    - bugprone-easily-swappable-parameters
    - cppcoreguidelines-pro-bounds-pointer-arithmetic
    - llvmlibc-restrict-system-libc-headers
    - llvmlibc-implementation-in-namespace
    - llvmlibc-callee-namespace
    - misc-use-internal-linkage
    - altera-unroll-loops

Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: No
  DefaultArguments: No
  TypeNameLimit: 24

Hover:
  ShowAKA: Yes
